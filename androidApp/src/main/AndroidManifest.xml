<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      neverForLocation is what buys no location permission on Android 12+: without it the platform
      assumes a BLE scan could be used to work out where the user is, and demands
      ACCESS_FINE_LOCATION — for talking to a dongle plugged into the dashboard of the car they are
      sitting in.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" tools:targetApi="s" />

    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <!--
      Foreground GPS for the trip route + start/arrival address. Also what a BLE scan legally
      requires on API 26-30 (without it startScan returns an empty list with NO error). One
      unrestricted declaration covers both. Recording with the screen off needs nothing more:
      TripTrackingService is a `location`-typed foreground service, which extends this grant for
      as long as it runs — see its manifest for why ACCESS_BACKGROUND_LOCATION stays out.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".CarScanApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="CarScan"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CarScan">

        <!-- AdMob refuses to serve a single ad without this — see androidApp/build.gradle.kts
             for where ${admobAppId} comes from. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <!-- Google Maps SDK key for the trip-detail map — from maps.api.key in local.properties.
             Blank when unset: the map draws no tiles but does not crash. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${mapsApiKey}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
