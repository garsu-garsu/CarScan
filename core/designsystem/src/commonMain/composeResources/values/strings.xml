    <!--
        About & Licenses. A hard legal gate before any store upload: SAEJ1979.json ships in the
        APK under CC BY-SA 4.0, and BY-SA's distribution obligation is the attribution, the
        license link, and a "no changes" statement below — see
        composeApp/src/commonMain/composeResources/files/obdb/SOURCE.md for the canonical text.

        %1$s/%2$s carry the URL and "CC BY-SA 4.0" in from code, untranslated by construction —
        translate only the sentence around them, never the placeholders' contents.
    -->
    <string name="about_version">Version %1$s</string>
    <string name="about_obdb_attribution">Vehicle signal definitions from OBDb (%1$s), licensed under %2$s.</string>
